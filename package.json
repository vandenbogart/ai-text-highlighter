{
  "name": "ai-text-highlighter",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check-tests": "bun scripts/check-tests.ts",
    "ci": "bun run typecheck && bun run lint && bun run check-tests && bun run build",
    "prepare": "git config core.hooksPath .githooks",
    "fetch-model": "bun scripts/fetch-model.ts",
    "build": "bun scripts/build.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/chrome": "^0.3.6",
    "eslint": "^10.13.0",
    "typescript": "^6",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  }
}
